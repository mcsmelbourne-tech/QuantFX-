# Runs the QuantFX scan on GitHub's servers, so Telegram alerts arrive even when your
# computer and phone are off. Secrets needed: TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID.
name: QuantFX scan

on:
  schedule:
    - cron: "*/15 * * * 1-5"      # every 15 min, Mon-Fri (UTC). GitHub's minimum is 5 min; runs can start a few minutes late.
  workflow_dispatch:               # lets you press "Run workflow" by hand
    inputs:
      reset_state:
        description: "Forget alert memory first (next run sends the full list)"
        type: boolean
        default: false

concurrency:
  group: qfx-scan                  # never run two scans at once
  cancel-in-progress: false

jobs:
  scan:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: requirements-job.txt

      - run: pip install -r requirements-job.txt

      # Alert memory ("only send what is new") is carried from run to run through the Actions cache.
      - name: Restore alert memory
        uses: actions/cache/restore@v4
        with:
          path: .qfx_conviction_state.json
          key: qfx-state-${{ github.run_id }}
          restore-keys: qfx-state-

      - name: Scan and send Telegram alerts
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          QFX_RESET: ${{ inputs.reset_state }}
        run: |
          if [ "$QFX_RESET" = "true" ]; then python scan_job.py --reset-state; else python scan_job.py; fi

      - name: Save alert memory
        if: always() && hashFiles('.qfx_conviction_state.json') != ''
        uses: actions/cache/save@v4
        with:
          path: .qfx_conviction_state.json
          key: qfx-state-${{ github.run_id }}-${{ github.run_attempt }}
